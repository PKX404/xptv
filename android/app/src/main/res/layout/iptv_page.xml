<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_panel_artwork"><include layout="@layout/drag_handle"/><EditText android:id="@+id/iptv_query" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_search" android:paddingHorizontal="16dp" android:drawableStart="@drawable/ic_search" android:drawablePadding="12dp" android:hint="Find your channel" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" android:textSize="16sp" android:textColor="#FFFFFF" android:textColorHint="#A9A1B5"/><Spinner android:id="@+id/iptv_country" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="Country"/><HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.chip.ChipGroup android:id="@+id/iptv_categories" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:singleLine="true"><com.google.android.material.chip.Chip android:id="@+id/category_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All" android:checkable="true" app:chipBackgroundColor="#2A2A3A" android:textColor="#FFFFFF"/><com.google.android.material.chip.Chip android:id="@+id/category_entertainment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entertainment" android:checkable="true" app:chipBackgroundColor="#2A2A3A" android:textColor="#FFFFFF"/><com.google.android.material.chip.Chip android:id="@+id/category_news" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="News" android:checkable="true" app:chipBackgroundColor="#2A2A3A" android:textColor="#FFFFFF"/><com.google.android.material.chip.Chip android:id="@+id/category_sports" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sports" android:checkable="true" app:chipBackgroundColor="#2A2A3A" android:textColor="#FFFFFF"/><com.google.android.material.chip.Chip android:id="@+id/category_kids" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kids" android:checkable="true" app:chipBackgroundColor="#2A2A3A" android:textColor="#FFFFFF"/><com.google.android.material.chip.Chip android:id="@+id/category_music" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Music" android:checkable="true" app:chipBackgroundColor="#2A2A3A" android:textColor="#FFFFFF"/><com.google.android.material.chip.Chip android:id="@+id/category_radio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Radio" android:checkable="true" app:chipBackgroundColor="#2A2A3A" android:textColor="#FFFFFF"/></com.google.android.material.chip.ChipGroup></HorizontalScrollView><TextView android:id="@+id/iptv_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#AFA8BB" android:accessibilityLiveRegion="polite"/><androidx.recyclerview.widget.RecyclerView android:id="@+id/iptv_results" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>
